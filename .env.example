# Copy to .env.local and fill in. All values are optional:
# the site falls back to the public defaults in content/site.ts.

# EmailJS (https://www.emailjs.com) — powers the contact form.
# Template variables: {{user_name}} {{user_email}} {{message}} {{reply_to}}
# Set the template's Reply-To to {{reply_to}}.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Canonical site URL used for metadata, OG images and the sitemap.
NEXT_PUBLIC_SITE_URL=https://mohammadehsan.vercel.app

# Optional overrides for public profile links (defaults live in content/site.ts).
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TWITTER_URL=
